# Copy to a machine-local .env file and adjust paths. Do not commit credentials.
export FLOWSPEC_REPO_ROOT="/path/to/flowspec-vla"
export FLOWSPEC_ARTIFACT_ROOT="/path/to/generated_artifacts/flowspec-vla"
export FLOWSPEC_MODEL_ROOT="/path/to/models/flowspec-vla"
export FLOWSPEC_DATASET_ROOT="/path/to/datasets/flowspec-vla"
export FLOWSPEC_LEROBOT_ROOT="/path/to/lerobot"
export HF_HOME="/path/to/huggingface-cache"
export ROBOSUITE_LOG_PATH="/tmp/robosuite.log"
export MUJOCO_GL="osmesa"
